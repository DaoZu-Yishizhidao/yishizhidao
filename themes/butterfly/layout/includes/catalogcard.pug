mixin catalogcard(cardtitle, catname, exclusiveToggle = true, dateFilter = {})
  - var cardId = 'card-' + Math.random().toString(36).substr(2, 8)
  - var exclusiveAttr = exclusiveToggle ? 'true' : 'false'
  .catalog-card(id=cardId data-exclusive-toggle=exclusiveAttr)
    .catalog-card-title= cardtitle
    .catalog-card-content
      //- 日期过滤函数
      - function shouldInclude(postDate) {
        - if (!dateFilter.mode) return true;
        - const postTime = new Date(postDate).getTime();
        - if (dateFilter.mode === 'after') {
          - return postTime >= new Date(dateFilter.date).getTime();
        - } else if (dateFilter.mode === 'before') {
          - return postTime <= new Date(dateFilter.date).getTime();
        - } else if (dateFilter.mode === 'between') {
          - const start = new Date(dateFilter.start).getTime();
          - const end = new Date(dateFilter.end).getTime();
          - return postTime >= start && postTime <= end;
        - }
        - return true;
      - }

      if catname
        //- 指定分类：原逻辑，只展示该分类及其子分类
        - const parentCategory = site.categories.data.find(cat => cat.name === catname)
        if parentCategory
          - const subcategories = site.categories.data.filter(cat => cat.parent === parentCategory._id)
          if subcategories.length > 0
            each subcat in subcategories
              - const filteredPosts = subcat.posts.sort('date', -1).toArray().filter(post => shouldInclude(post.date))
              if filteredPosts.length > 0
                details.toggle(open)
                  summary.toggle-button= subcat.name
                  .toggle-content
                    each post in filteredPosts
                      a.post-link(href=url_for(post.path) title=post.title)
                        span.post-title= post.title
                        span.post-date= date(post.date, 'YYYY-MM-DD')
                        span.post-category  
                          each item, index in post.categories.data
                            a(href=url_for(item.path)).post-meta-categories #[=item.name]
                            if index < post.categories.data.length - 1
                              i.fas.fa-angle-right.post-meta-separator
          else
            - const filteredPosts = parentCategory.posts.sort('date', -1).toArray().filter(post => shouldInclude(post.date))
            if filteredPosts.length > 0
              each post in filteredPosts
                a.post-link(href=url_for(post.path) title=post.title)
                  span.post-title= post.title
                  span.post-date= date(post.date, 'YYYY-MM-DD')
                span.post-category
                  each item, index in post.categories.data
                    a(href=url_for(item.path)).post-meta-categories #[=item.name]
                    if index < post.categories.data.length - 1
                      i.fas.fa-angle-right.post-meta-separator
        else
          p 未找到分类：#{catname}

      else
        //- 未指定分类：聚合所有顶级分类，每个顶级分类作为一个 details 块
        - const topCategories = site.categories.data.filter(cat => !cat.parent)
        if topCategories.length > 0
          each topCat in topCategories
            - const filteredPosts = topCat.posts.sort('date', -1).toArray().filter(post => shouldInclude(post.date))
            if filteredPosts.length > 0
              details.toggle(open)
                summary.toggle-button= topCat.name
                .toggle-content
                  each post in filteredPosts
                    .card-post-item
                      a.post-link(href=url_for(post.path) title=post.title)
                        span.post-title= post.title
                        span.post-date= date(post.date, 'YYYY-MM-DD')
                      span.post-category
                        each item, index in post.categories.data
                          a(href=url_for(item.path)).post-meta-categories #[=item.name]
                          if index < post.categories.data.length - 1
                            i.fas.fa-angle-right.post-meta-separator
            else
              //- 无子分类：直接展示该顶级分类下的文章
              - const filteredPosts = topCat.posts.sort('date', -1).toArray().filter(post => shouldInclude(post.date))
              if filteredPosts.length > 0
                details.toggle(open)
                  summary.toggle-button= topCat.name
                  .toggle-content
                    each post in filteredPosts
                      a.post-link(href=url_for(post.path))
                        span.post-title= post.title
                        span.post-date= date(post.date, 'YYYY-MM-DD')
                      span.post-category
                        each item, index in post.categories.data
                          a(href=url_for(item.path)).post-meta-categories #[=item.name]
                          if index < post.categories.data.length - 1
                            i.fas.fa-angle-right.post-meta-separator
        else
          p 暂无分类