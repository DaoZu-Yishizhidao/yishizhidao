mixin carditems(filteredPosts, limit,dateField = 'date')
    - const maxPosts = (typeof limit === 'number' && limit >= 0) ? limit : filteredPosts.length
    - const displayPosts = filteredPosts.slice(0, maxPosts)
    if displayPosts.length > 0
        each post in displayPosts
            .card-post-item
                a.post-link(href=url_for(post.path) title=post.title)
                    span.post-title= post.title
                    span.post-date= date(post[dateField], 'YYYY-MM-DD')
                span.post-category
                    each item, index in post.categories.data
                        a(href=url_for(item.path)).post-meta-categories #[=item.name]
                        if index < post.categories.data.length - 1
                            i.fas.fa-angle-right.post-meta-separator

    else
        p.no-posts 没有找到相关内容。