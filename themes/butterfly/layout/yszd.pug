extends includes/layout.pug

block content
    #catalog-homepage.catalog-homepage.nc(class=masonryLayoutClass)
      .catalayout
        .catalayout-header
          #post
            article#article-container.container.post-content
              != page.content
        .catalayout-content
          include ./includes/mixins/cardtitle.pug
          include ./includes/mixins/catacard.pug
          - const dateFilter = { mode: 'before', date: '2025-11-20' }
          +cardtitle('《道经卷》', false)
            +catacard({name: '道经卷'}, dateFilter)
          +cardtitle('《道行卷》', false)
            +catacard({name: '道祖之道'}, dateFilter)
          +cardtitle('《道境卷》', false)
            +catacard({name: '道境卷'}, dateFilter)