extends includes/layout.pug

block content
    #catalog-homepage.catalog-homepage.nc(class=masonryLayoutClass)
      .catalayout
        .catalayout-header
          #post
            article#article-container.container.post-content
              != page.content
        .catalayout-content
          include ./includes/mixins/cardtitle.pug
          include ./includes/mixins/catacard.pug
          +cardtitle('《道祖引道》', false)
            +catacard({ name: '道祖引道' }, false)
          +cardtitle('《道论》', false)
            +catacard({ name: '道论' }, false)
          +cardtitle('《道行卷》', false)
            +catacard({ name: '道行卷', parent: '道祖道场' }, false)